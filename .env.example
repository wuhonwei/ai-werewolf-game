# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Auth (production: set AUTH_REQUIRED=true)
AUTH_REQUIRED=false
JWT_SECRET=change-me-in-production-use-long-random-string

# Redis (empty = in-memory game store)
REDIS_URL=redis://localhost:6379

# PostgreSQL (set USE_POSTGRES=true to persist users)
DATABASE_URL=postgresql://werewolf:werewolf@localhost:5432/werewolf
USE_POSTGRES=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Cloud Voice + OSS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_TTS_APP_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-hangzhou

# WeChat Mini Program (required for production login)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
